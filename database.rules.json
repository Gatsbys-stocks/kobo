{
  "rules": {
    ".read": false,
    ".write": false,

    "sessions": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null",

        "orders": {
          "$tableId": {
            "_notes": {
              "$itemId": {
                ".validate": "newData.isString() && newData.val().length <= 300"
              }
            },
            "_done": {
              "$itemId": {
                ".validate": "newData.val() === true"
              }
            },
            "_people": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "$itemId": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
            }
          }
        }
      }
    }
  }
}
